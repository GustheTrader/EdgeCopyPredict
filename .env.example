# Database
DATABASE_URL=postgres://arbitek:arbitek@localhost:5432/arbitek

# Redis
REDIS_URL=redis://localhost:6379

# API
BIND_ADDR=127.0.0.1:8080
ENVIRONMENT=development
LOG_LEVEL=info

# Worker
WORKER__MODE=execution-live-once
WORKER__RUN_MIGRATIONS_ON_STARTUP=true
WORKER__EXECUTION_BATCH_SIZE=10
WORKER__POLYMARKET_POLL_INTERVAL_SECONDS=30
WORKER__KALSHI_POLL_INTERVAL_SECONDS=30
WORKER__SIGNAL_NORMALIZE_INTERVAL_MS=250
WORKER__RISK_EVALUATE_INTERVAL_MS=250
WORKER__PAPER_EXECUTION_INTERVAL_MS=250
WORKER__PNL_REFRESH_INTERVAL_MS=1000

# Platforms
POLYMARKET__DATA_API_BASE_URL=https://data-api.polymarket.com
POLYMARKET__CLOB_API_BASE_URL=https://clob.polymarket.com
KALSHI__REST_API_BASE_URL=https://external-api.kalshi.com/trade-api/v2
KALSHI__WEBSOCKET_BASE_URL=wss://external-api.kalshi.com/ws-api

# Auth
AUTH__JWT_SECRET=change-me-in-production-min-32-chars-long
AUTH__ADMIN_PASSWORD=secret
AUTH__TOKEN_EXPIRY_HOURS=24

# Trading
LIVE_TRADING_ENABLED=false

# Platform credentials (optional)
POLYMARKET__PRIVATE_KEY=
KALSHI__API_KEY=
KALSHI__API_SECRET=
